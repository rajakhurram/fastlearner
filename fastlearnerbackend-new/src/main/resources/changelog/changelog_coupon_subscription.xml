<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro
        http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

    <changeSet id="04212026_coupon_subscription_table" author="claude">
        <createTable tableName="coupon_subscription">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="coupon_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_coupon_subscription_coupon" references="coupon(id)"/>
            </column>
            <column name="subscription_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_coupon_subscription_subscription" references="subscription(id)"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValue="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_coupon_subscription_coupon_id" tableName="coupon_subscription">
            <column name="coupon_id"/>
        </createIndex>

        <createIndex indexName="idx_coupon_subscription_subscription_id" tableName="coupon_subscription">
            <column name="subscription_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="04212026_add_applies_to_column" author="claude">
        <addColumn tableName="coupon">
            <column name="applies_to" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="04212026_add_discount_unit_column" author="claude">
        <addColumn tableName="coupon">
            <column name="discount_unit" type="VARCHAR(50)">
                <constraints nullable="true" />
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
